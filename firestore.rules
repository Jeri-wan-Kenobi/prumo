rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa lê e escreve só a própria pasta (usuarios/{seu UID}/...).
    // Contas novas precisam ter o e-mail confirmado.
    // A conta criada no console (ngp4jnsuaCOtFuQOXH96CeDiKux1) fica liberada mesmo sem confirmação.
    match /usuarios/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && (request.auth.token.email_verified == true
                             || uid == "ngp4jnsuaCOtFuQOXH96CeDiKux1");
    }
    // Todo o resto do banco fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
