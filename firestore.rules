rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só a conta com este UID lê e escreve, e só dentro da própria pasta.
    // Troque COLE_SEU_UID_AQUI pelo UID copiado em Authentication > Users (passo 3).
    match /usuarios/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && uid == "COLE_SEU_UID_AQUI";
    }
    // Todo o resto do banco fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
